# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data backups (contain PII: emails, phones, snapshots)
/backups/

# reverse-engineering captures (contain auth cookies, JWTs, sample responses)
/scripts/reverse-eng/output/

# netlify
.netlify/

# logs + screenshots
*.log
*.png
*.bak

# scripts with hardcoded secrets (n8n API keys, Supabase service keys, Tokko passwords)
# Should be refactored to read from env vars before tracking.
/scripts/n8n-*.mjs
/scripts/deploy-n8n-*.mjs
/scripts/gmail-zonaprop-backfill.mjs
/scripts/reverse-eng/capture.mjs

# temp recovery helper with hardcoded Tokko panel creds — delete after use
/geo-loop.sh

# root-level dev/debug utilities (not part of the app)
/clear_accounts.ts
/list_accounts.ts
/test.js
/temp_production.tsx.bak
